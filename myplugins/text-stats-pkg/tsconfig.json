{
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "outDir": "lib",
    "rootDir": "src",
    "declaration": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    // 本仓库内开发时的类型解析；发布后由安装方 node_modules 提供。
    "paths": {
      "@deepseek-ai/cordis": ["../../vendor/cordis/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-tools": ["../../packages/core/tools/lib/types/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
